#!/bin/sh
# Jacquard pre-commit guard (local, untracked):
# 1. nobody commits on the main branch; work reaches it by integrating a branch (the first commit of a new repo is allowed);
# 2. the personal local files never enter the index, whatever command staged them.
main="{{MAIN}}"                    # the main branch, from project.md
local_re="{{LOCAL_FOLDER_REGEX}}"  # the local folder with dots escaped, e.g. \.jacquard
for v in "$main" "$local_re"; do
  case "$v" in *'{'"{"*|'') echo "Jacquard guard: not configured." >&2; exit 1 ;; esac
done
gitdir="$(git rev-parse --git-dir)" || exit 1
branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
# Integrating a branch (finishing a merge) is how work reaches main; a plain commit is not.
if [ "$branch" = "$main" ] && git rev-parse --verify -q HEAD >/dev/null \
   && [ ! -f "$gitdir/MERGE_HEAD" ] && [ ! -f "$gitdir/SQUASH_MSG" ]; then
  echo "Jacquard: commits on '$main' are not allowed. Create a branch: git switch -c <id-short-name>" >&2
  exit 1
fi
staged="$(git diff --cached --name-only -z | tr '\0' '\n')" || exit 1
printf '%s\n' "$staged" | grep -E '^('"$local_re"'(/|$)|CLAUDE\.local\.md$|\.claude/settings\.local\.json$)' >/dev/null
case $? in
  1) ;;
  0)  echo "Jacquard: personal local files are staged (the local folder, CLAUDE.local.md, .claude/settings.local.json). Unstage them: git restore --staged <path>" >&2
   exit 1 ;;
*) echo "Jacquard guard: check failed (is it configured?)." >&2; exit 1 ;;
esac
exit 0
