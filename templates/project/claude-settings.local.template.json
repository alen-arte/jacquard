{
  "env": { "JACQUARD_AGENT": "1" },
  "permissions": {
    "additionalDirectories": ["{{PERSONAL_PROJECT_FOLDER}}"],
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git switch -c away/*)",
      "Bash(git revert *)",
      "Bash(date)",
      "Bash(date +*)",
      "Bash(~/.claude/jacquard/scripts/away-guard.sh on {{LOCAL_FOLDER}} *)",
      "Bash(~/.claude/jacquard/scripts/away-guard.sh off {{LOCAL_FOLDER}})",
      "Bash(~/.claude/jacquard/scripts/roadmap-index.sh --check {{LOCAL_FOLDER}}/docs/roadmap.md)",
      "Bash(~/.claude/jacquard/scripts/roadmap-index.sh --write {{LOCAL_FOLDER}}/docs/roadmap.md)",
      "Bash(~/.claude/jacquard/scripts/structure-check.sh)",
      "Bash(~/.claude/jacquard/scripts/structure-check.sh *)",
      "Bash(~/.claude/jacquard/scripts/cloud.sh status)",
      "Bash(~/.claude/jacquard/scripts/personal-sync.sh)",
      "Bash(~/.claude/jacquard/scripts/personal-sync.sh *)",
      "Bash(~/.claude/jacquard/scripts/push-guard.sh install)",
      "Bash(~/.claude/jacquard/scripts/push-guard.sh check)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin *)",
      "{{PUSH_ALLOW_RULES, for origin and each project.md › Git › Own remote that is the user's own and private: \"Bash(git push <remote> *)\", \"Bash(git push -u <remote> *)\"; public or shared with others: none, so every push there asks}}",
      "Edit(/{{LOCAL_FOLDER}}/**)",
      "Edit(~/repos/jacquard-personal/projects/{{PROJECT_SLUG}}/**)",
      "{{CHECK_COMMANDS_AS_BASH_RULES}}"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git pull*)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git stash *)",
      "Bash(git revert --abort*)",
      "Bash(git rm *)",
      "Bash(git remote *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git tag *)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(rm -R*)",
      "Bash(gh *)",
      "Bash(~/.claude/jacquard/scripts/protected-push.sh *)",
      "Bash(~/.claude/jacquard/scripts/push-guard.sh install --widen)",
      "Edit(/.claude/**)",
      "{{PACKAGE_INSTALL_AS_BASH_RULES}}",
      "{{DEPLOY_CLI_AS_BASH_RULES}}"
    ],
    "deny": [
      "Edit(~/.claude/jacquard/**)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push * +*)",
      "Bash(git -c*)",
      "Bash(git config*)",
      "Bash(git commit *--amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git reset *--h*)",
      "Bash(git filter-*)",
      "Bash(git update-ref*)",
      "Bash(git replace*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git gc *--prune*)",
      "Bash(git branch -f*)",
      "Bash(git switch -C*)",
      "Bash(git checkout -B*)",
      "Bash(git clean*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git stash *--output*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add *{{LOCAL_FOLDER}}*)",
      "Bash(git add *CLAUDE.local.md*)",
      "Bash(git add *settings.local.json*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(gh gist *)",
      "Bash(gh repo create*)",
      "Bash(git -C*)",
      "Bash(git push -uf*)",
      "Bash(git push *-uf*)",
      "Bash(git push *-fu*)",
      "Bash(git commit *--am*)",
      "Bash(git commit *--no-v*)",
      "Bash(git commit * -n*)",
      "Bash(git commit -n*)",
      "Bash(git add *--f*)",
      "Bash(git add * -f*)",
      "Bash(git add *-Af*)",
      "Bash(git add *-fA*)",
      "Bash(git show *--output*)",
      "Bash(gh repo edit*)",
      "Bash(git commit *-an*)",
      "Bash(git commit *-na*)",
      "Bash(git add *-vf*)",
      "Bash(git add *-fv*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git *--exec*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *heads/main*)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master*)",
      "Bash(git push *heads/master*)",
      "Bash(git push * HEAD)",
      "Bash(git push * HEAD *)",
      "Bash(git push * @)",
      "Bash(git push * @ *)",
      "Bash(git push *--all*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * -d)",
      "Bash(git push * :*)",
      "Bash(git push * -*)",
      "Bash(git push *refs/*)",
      "Bash(git push *'*)",
      "Bash(git push *\"*)",
      "Bash(git fetch *--u*)",
      "Bash(git fetch * +*)",
      "Bash(git fetch *:*)",
      "Bash(git push *--no-v*)",
      "Bash(git push *$*)",
      "Bash(git push *`*)",
      "Bash(git push *{*)",
      "Bash(git *<(*)",
      "Bash(git *>(*)",
      "Bash(env -i*)",
      "Bash(env - *)",
      "Bash(*CLAUDECODE*)",
      "Bash(*CLAUDE_CODE_ENTRYPOINT*)",
      "Bash(*JACQUARD_AGENT*)",
      "Bash(*HUSKY*)",
      "Bash(*hooksPath*)",
      "Bash(*GIT_CONFIG*)",
      "Bash(*HOME=*)",
      "Bash(*>*.git/*)",
      "Bash(*>*gitconfig*)",
      "Bash(*>*config/git*)",
      "Bash(cd .git)",
      "Bash(cd .git/*)",
      "Bash(cd */.git)",
      "Bash(cd */.git/*)",
      "Edit(/.git/**)",
      "Edit(/.husky/pre-push)",
      "Edit(/.husky/_/**)",
      "Edit(/{{LOCAL_FOLDER}}/away/.away-active)",
      "{{PROJECT_DENY_RULES, e.g. a push to each branch that publishes or deploys, from project.md › Git: \"Bash(git push * production)\", \"Bash(git push * production *)\", \"Bash(git push *:production*)\", \"Bash(git push *heads/production*)\"}}"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.claude/jacquard/scripts/away-guard.sh\" permission \"{{LOCAL_FOLDER}}\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "\"$HOME/.claude/jacquard/scripts/bash-guard.sh\" \"{{LOCAL_FOLDER}}\"", "timeout": 10 }] }
    ],
    "Elicitation": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.claude/jacquard/scripts/away-guard.sh\" elicitation \"{{LOCAL_FOLDER}}\"", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.claude/jacquard/scripts/session-start.sh\" \"{{LOCAL_FOLDER}}\"", "timeout": 10 }] }
    ]
  }
}
