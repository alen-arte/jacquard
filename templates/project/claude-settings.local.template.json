{
  "permissions": {
    "additionalDirectories": ["{{PERSONAL_PROJECT_FOLDER}}"],
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git switch -c away/*)",
      "Bash(git revert *)",
      "Bash(date)",
      "Bash(date +*)",
      "Bash(~/.claude/jacquard/scripts/away-guard.sh on {{LOCAL_FOLDER}})",
      "Bash(~/.claude/jacquard/scripts/away-guard.sh off {{LOCAL_FOLDER}})",
      "Bash(~/.claude/jacquard/scripts/roadmap-index.sh *)",
      "Edit(/{{LOCAL_FOLDER}}/**)",
      "Edit(~/repos/jacquard-personal/projects/{{PROJECT_SLUG}}/**)",
      "{{CHECK_COMMANDS_AS_BASH_RULES}}"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git stash *)",
      "Bash(git revert --abort*)",
      "Bash(git rm *)",
      "Bash(git remote *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git tag *)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(rm -R*)",
      "Bash(gh *)",
      "{{PACKAGE_INSTALL_AS_BASH_RULES}}",
      "{{DEPLOY_CLI_AS_BASH_RULES}}"
    ],
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push * +*)",
      "Bash(git -c*)",
      "Bash(git config*)",
      "Bash(git commit *--amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git reset *--h*)",
      "Bash(git filter-*)",
      "Bash(git update-ref*)",
      "Bash(git replace*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git gc *--prune*)",
      "Bash(git branch -f*)",
      "Bash(git switch -C*)",
      "Bash(git checkout -B*)",
      "Bash(git clean*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git stash *--output*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add *{{LOCAL_FOLDER}}*)",
      "Bash(git add *CLAUDE.local.md*)",
      "Bash(git add *settings.local.json*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(gh gist *)",
      "Bash(gh repo create*)",
      "Bash(git -C*)",
      "Bash(git push -uf*)",
      "Bash(git push *-uf*)",
      "Bash(git push *-fu*)",
      "Bash(git commit *--am*)",
      "Bash(git commit *--no-v*)",
      "Bash(git commit * -n*)",
      "Bash(git commit -n*)",
      "Bash(git add *--f*)",
      "Bash(git add * -f*)",
      "Bash(git add *-Af*)",
      "Bash(git add *-fA*)",
      "Bash(git show *--output*)",
      "Bash(gh repo edit*)",
      "Bash(git commit *-an*)",
      "Bash(git commit *-na*)",
      "Bash(git add *-vf*)",
      "Bash(git add *-fv*)",
      "{{PROJECT_DENY_RULES, e.g. push to a shared main}}"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.claude/jacquard/scripts/away-guard.sh\" permission \"{{LOCAL_FOLDER}}\"", "timeout": 10 }] }
    ],
    "Elicitation": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.claude/jacquard/scripts/away-guard.sh\" elicitation \"{{LOCAL_FOLDER}}\"", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.claude/jacquard/scripts/away-guard.sh\" session-start \"{{LOCAL_FOLDER}}\"", "timeout": 10 }] }
    ]
  }
}
